# Copy to .env for local development. Every variable here has a default in the
# `env.schema` block of astro.config.mjs, so an empty .env still runs — the contact
# form will just log messages instead of sending them.

# ---------------------------------------------------------------------------
# Mail driver: resend | smtp | log
# ---------------------------------------------------------------------------
#   resend  production — sends through the Resend API
#   smtp    local      — sends into Mailpit
#   log     default    — prints the message to the server console, sends nothing
MAIL_DRIVER=smtp

# Must be an address on a domain verified in Resend, or Resend rejects the send.
MAIL_FROM="MarketDay <noreply@marketday.app>"

# Where contact submissions land, chosen by the role tab the sender picked.
CONTACT_INBOX_SHOPPER=hello@marketday.app
CONTACT_INBOX_VENDOR=vendors@marketday.app

# ---------------------------------------------------------------------------
# Resend (MAIL_DRIVER=resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# SMTP / Mailpit (MAIL_DRIVER=smtp)
# ---------------------------------------------------------------------------
# Mailpit already runs in the API's docker-compose stack:
#   cd ../backend && docker compose up -d mailpit
# SMTP on 1025, web UI on http://localhost:8025
#
# Use 127.0.0.1 rather than localhost: localhost can resolve to IPv6 ::1, which Docker
# Desktop's port forwarding doesn't answer, and the SMTP connection hangs instead of
# failing.
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
# Leave both empty for Mailpit — it accepts unauthenticated SMTP, and sending an empty
# auth block makes nodemailer attempt AUTH and fail.
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# ---------------------------------------------------------------------------
# Contact form rate limit (per IP, per instance)
# ---------------------------------------------------------------------------
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
