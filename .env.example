# Copy to .env for local development. Every variable here has a default in the
# `env.schema` block of astro.config.mjs, so an empty .env still runs — the forms will
# just post to a local API on port 3000.

# ---------------------------------------------------------------------------
# MarketDay API
# ---------------------------------------------------------------------------
# The forms (contact, delete-account) post GraphQL mutations to the API, which owns the
# templating and the actual sending. Nothing is emailed from this site. /markets reads its
# market list from the same API.
#
# Run the API locally with:
#   cd ../backend && pnpm start:dev
#
# Use 127.0.0.1 rather than localhost: localhost can resolve to IPv6 ::1, which Docker
# Desktop's port forwarding doesn't answer, and the request hangs instead of failing.
API_URL=http://127.0.0.1:3000/graphql

# Sent as the `x-api-key` header. Must match API_KEY in the backend's .env. The API
# leaves its gate open when it has no key configured, so this can stay empty locally —
# in production it is required.
API_KEY=

# How long to wait on the API before giving up, in milliseconds.
API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Contact form rate limit (per IP, per instance)
# ---------------------------------------------------------------------------
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# ---------------------------------------------------------------------------
# Delete-account form rate limit (per IP, per instance)
# ---------------------------------------------------------------------------
DELETE_ACCOUNT_RATE_LIMIT_MAX=5
DELETE_ACCOUNT_RATE_LIMIT_WINDOW_MS=3600000

# ---------------------------------------------------------------------------
# Test-build invite dialog rate limit (per IP, per instance)
# ---------------------------------------------------------------------------
# The dialog the store badges open while the app is unlisted.
APP_INVITE_RATE_LIMIT_MAX=8
APP_INVITE_RATE_LIMIT_WINDOW_MS=3600000

# ---------------------------------------------------------------------------
# Vendor portal (/vendor/*)
# ---------------------------------------------------------------------------
# Sign-in, Google sign-in and password reset, per IP, per instance. The API separately
# locks an account after repeated wrong passwords.
VENDOR_AUTH_RATE_LIMIT_MAX=10
VENDOR_AUTH_RATE_LIMIT_WINDOW_MS=900000

# The Google OAuth *web* client ID: the same value as GOOGLE_CLIENT_ID in the backend's
# .env, because the API only accepts ID tokens minted for that client. In Google Cloud
# Console, add https://marketday.ie and http://localhost:4321 to the client's
# "Authorized JavaScript origins". Leave empty to hide the Google button.
PUBLIC_GOOGLE_CLIENT_ID=
