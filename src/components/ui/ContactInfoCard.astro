---
import IconMail from '../icons/IconMail.astro';
import IconBag from '../icons/IconBag.astro';
import type { ContactCard } from '../../data/contact';

const contactIcons = {
	mail: IconMail,
	bag: IconBag,
} as const;

type Props = ContactCard;

const { icon, accent, title, detail, meta } = Astro.props;
const Icon = contactIcons[icon];
const isClay = accent === 'clay';
---

<div class="rounded-[22px] bg-white p-6 shadow-card">
	<div
		class:list={[
			'mb-3.5 flex h-11 w-11 items-center justify-center rounded-[13px]',
			isClay ? 'bg-clay/14' : 'bg-brand/13',
		]}
	>
		<Icon class={`h-5.25 w-5.25 ${isClay ? 'text-clay' : 'text-brand'}`} strokeWidth={1.9} />
	</div>
	<div class="mb-1.5 font-display text-[17px] font-bold text-ink">{title}</div>
	<div class="mb-1 text-[14.5px] text-body">{detail}</div>
	<div class="text-[13.5px] text-muted">{meta}</div>
</div>
