---
import { Image } from 'astro:assets';
import appStoreBadge from '../../assets/badges/app-store.svg';
import googlePlayBadge from '../../assets/badges/google-play.svg';

interface Props {
	store: 'apple' | 'google';
	/**
	 * Store listing to link to. Omit while the app is unreleased: the badge then renders as a
	 * button that announces itself with `data-store-badge`, which `ui/AppInviteModal.astro`
	 * binds to so a click opens the testing-programme dialog instead.
	 */
	href?: string;
	class?: string;
}

const { store, href, class: className } = Astro.props;

// Official artwork from Apple's and Google's badge kits, used unmodified. Both are the black
// badge: it is Apple's preferred variant and the only one Google ships, so the pair always
// matches. Rendered as <img> rather than inlined — the files use generic ids and `.st*` class
// names that would leak into the page's CSS.
const badge =
	store === 'apple'
		? { src: appStoreBadge, alt: 'Download on the App Store' }
		: { src: googlePlayBadge, alt: 'Get it on Google Play' };

const Tag = href ? 'a' : 'button';
const tagProps = href
	? { href }
	: { type: 'button' as const, 'data-store-badge': store, 'aria-haspopup': 'dialog' as const };
---

<Tag
	{...tagProps}
	class:list={['block shrink-0 rounded-[9px] transition-opacity hover:opacity-90', className]}
>
	<Image src={badge.src} alt={badge.alt} loading="eager" class="block h-13 w-auto" />
</Tag>
