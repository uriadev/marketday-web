---
import type { NoticeTone } from '../../data/vendor-portal';

interface Props {
	tone: NoticeTone;
}

const { tone } = Astro.props;

const toneClass: Record<NoticeTone, string> = {
	brand: 'bg-mint text-forest',
	gold: 'bg-gold/16 text-[#9a6516]',
	danger: 'bg-danger/10 text-danger',
	muted: 'bg-sand text-body',
};
---

<span
	class:list={[
		'inline-flex h-7 shrink-0 items-center gap-1.75 rounded-full px-3 text-[12.5px] font-semibold',
		toneClass[tone],
	]}
>
	<span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
	<slot />
</span>
