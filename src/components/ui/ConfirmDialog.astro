---
/**
 * One confirmation dialog per portal page, filled in and opened by `PortalForm`'s script for
 * any form with a `confirm` prop. `method="dialog"` makes the pressed button's `value` the
 * dialog's `returnValue`, so Cancel, Escape and a backdrop-less close all read as "no".
 */
---

<dialog
	data-confirm-dialog
	aria-labelledby="confirm-dialog-title"
	class="m-auto w-[calc(100%-2rem)] max-w-105 rounded-[22px] bg-white p-0 shadow-[0_30px_80px_-20px_rgba(31,42,37,0.5)] backdrop:bg-ink/55 backdrop:backdrop-blur-[3px]"
>
	<form method="dialog" class="p-6 sm:p-7">
		<h2 id="confirm-dialog-title" class="mb-2 font-display text-[19px] font-bold text-ink">Are you sure?</h2>
		<p data-confirm-message class="mb-6 text-[15px] leading-[1.6] text-body"></p>
		<div class="flex flex-wrap justify-end gap-2.5">
			<button
				value="cancel"
				class="h-11 rounded-full px-5 text-[15px] font-semibold text-body transition-colors hover:bg-cream"
			>
				Cancel
			</button>
			<button
				value="confirm"
				data-confirm-accept
				class="h-11 rounded-full bg-forest px-5.5 text-[15px] font-semibold text-white transition-opacity hover:opacity-90"
			>
				Confirm
			</button>
		</div>
	</form>
</dialog>
