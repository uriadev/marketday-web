---
import type { FaqEntry } from '../../data/home';

type Props = FaqEntry;

const { q, a } = Astro.props;
---

<details class="group rounded-[18px] bg-white px-6 py-5.5 shadow-[0_2px_12px_rgba(31,42,37,0.05)]">
	<summary class="flex list-none cursor-pointer items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
		<span class="text-[17px] font-semibold tracking-[-0.01em] text-ink">{q}</span>
		<span class="relative flex h-6.5 w-6.5 shrink-0 items-center justify-center rounded-full bg-brand/13">
			<span class="absolute h-0.5 w-2.75 rounded-[1px] bg-brand"></span>
			<span class="absolute h-2.75 w-0.5 rounded-[1px] bg-brand transition-transform duration-150 group-open:scale-y-0"
			></span>
		</span>
	</summary>
	<div class="mt-3 max-w-140 text-[15px] leading-[1.6] text-body">{a}</div>
</details>
