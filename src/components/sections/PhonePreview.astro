---
import { Image } from 'astro:assets';

import IconSearch from '../icons/IconSearch.astro';
import bantryImage from '../../assets/bantry.webp';
import douglasImage from '../../assets/douglas.webp';
import mahonImage from '../../assets/mahon.webp';

const upcomingMarkets = [
	{ image: mahonImage, name: 'Mahon Point Farmers Market', time: 'Sut · 11:00–14:00', badge: 'Today' },
	{ image: bantryImage, name: 'Bantry Market', time: 'Tue · 10:00–13:00' },
];

const nearbyMarket = {
	image: douglasImage,
	name: 'Douglas Farmers Market',
	schedule: 'every week on Saturday at 9',
	area: 'Cork',
	distance: '4.1 km',
};
---

<div class="flex w-full flex-[1_1_300px] justify-center lg:w-auto lg:flex-[0_0_300px]">
	<div class="h-130 w-72 rounded-t-[44px] bg-ink p-2.5 pb-0 shadow-phone">
		<div class="relative h-full w-full overflow-hidden rounded-t-[36px] bg-[#F2F2F7] px-4 pt-6.5 pb-0">
			<div class="mb-3.5 flex items-start justify-between">
				<div class="font-display text-[22px] font-extrabold leading-none tracking-[-0.02em] text-black">MarketDay</div>
				<div class="flex items-center gap-1 text-xs font-bold text-brand">
					<div class="h-1.5 w-1.5 rounded-full bg-brand"></div>Cork City
				</div>
			</div>
			<div class="mb-3.5 flex h-9.5 items-center gap-2 rounded-full bg-white px-3.5 shadow-[0_1px_4px_rgba(0,0,0,0.06)]">
				<IconSearch class="h-3.25 w-3.25 shrink-0" />
				<span class="truncate text-xs text-[rgba(60,60,67,0.5)]">Search markets, vendors or produce</span>
			</div>
			<div class="mb-3.5 rounded-[20px] bg-brand p-4">
				<div class="mb-1 font-display text-base leading-[1.15] font-bold text-white">Support local producers</div>
				<div class="text-[11.5px] leading-[1.35] text-white/85">
					Every pre-order goes straight to the stallholder — pay at the stall when you collect.
				</div>
				<div class="mt-3 inline-flex h-7 items-center rounded-full bg-white px-3.25 text-[11.5px] font-bold text-brand">
					How it works
				</div>
			</div>
			<div class="mb-2 text-sm font-bold text-black">Upcoming markets</div>
			<div class="mb-3.5 flex gap-2">
				{
					upcomingMarkets.map((market) => (
						<div class="relative h-25 flex-1 overflow-hidden rounded-2xl bg-white">
							<div class="absolute inset-x-0 top-0 h-[85%] bg-mint">
								<Image
									src={market.image}
									alt=""
									width={128}
									densities={[1, 2]}
									class="h-full w-full object-cover"
								/>
							</div>
							{market.badge && (
								<span class="absolute top-1.5 right-1.5 flex h-4 items-center rounded-full bg-white px-1.5 text-[8px] font-bold text-forest">
									{market.badge}
								</span>
							)}
							<div class="absolute inset-x-0 bottom-0 px-1.5 pt-4 pb-1 bg-[linear-gradient(to_top,#fff_65%,rgba(255,255,255,0.9)_78%,rgba(255,255,255,0))]">
								<div class="truncate text-[11px] leading-[1.2] font-bold text-black">{market.name}</div>
								<div class="truncate text-[9.5px] text-[rgba(60,60,67,0.55)]">{market.time}</div>
							</div>
						</div>
					))
				}
			</div>
			<div class="mb-2 text-sm font-bold text-black">Nearby markets</div>
			<div class="flex items-center gap-2.5 rounded-2xl bg-white px-3 py-2.5 shadow-[0_2px_10px_rgba(0,0,0,0.05)]">
				<div class="h-10.5 w-10.5 shrink-0 overflow-hidden rounded-xl bg-mint">
					<Image
						src={nearbyMarket.image}
						alt=""
						width={44}
						densities={[1, 2]}
						class="h-full w-full object-cover"
					/>
				</div>
				<div class="min-w-0 flex-1">
					<div class="text-[12.5px] font-bold text-black">{nearbyMarket.name}</div>
					<div class="flex items-center">
						<div>
							<div class="mb-0.75 text-[10.5px] text-[rgba(60,60,67,0.55)]">{nearbyMarket.schedule} <span class="rounded-full bg-brand/13 px-1.75 py-px text-[9.5px] font-semibold text-brand">{nearbyMarket.area}</span></div>
						</div>
						<span class="shrink-0 text-[11px] font-bold text-brand">{nearbyMarket.distance}</span>
					</div>
				</div>
			
			</div>
		</div>
	</div>
</div>
