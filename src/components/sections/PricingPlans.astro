---
import PricingPlanCard from '../ui/PricingPlanCard.astro';
import { pricingPlans } from '../../data/pricing';
---

<!-- A lone plan (the free pilot) is centred at card width rather than stretched across the page. -->
<div
	class:list={[
		'mx-auto flex max-w-310 flex-wrap items-stretch gap-6 px-5 pb-16 sm:px-8 lg:px-14 lg:pb-24',
		pricingPlans.length === 1 && 'justify-center *:max-w-150',
	]}
>
	{pricingPlans.map((plan) => <PricingPlanCard {...plan} />)}
</div>
