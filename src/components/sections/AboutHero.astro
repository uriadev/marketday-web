---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
---

<div class="mx-auto max-w-310 px-5 pt-6 pb-10 sm:px-8 lg:px-14 lg:pb-18">
	<SectionEyebrow>About MarketDay</SectionEyebrow>
	<h1 class="mb-5 max-w-180 font-display text-[34px] leading-[1.03] font-bold tracking-[-0.025em] text-ink sm:text-[42px] lg:text-[54px]">
		Built to keep market day full, not leftover.
	</h1>
	<p class="max-w-155 text-[16px] leading-[1.55] text-body sm:text-[18px]">
		We started MarketDay after one too many Saturdays arriving to an empty stall table. Now shoppers reserve
		ahead and vendors sell to order — so nobody queues, and nothing good goes to waste.
	</p>
</div>
