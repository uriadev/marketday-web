---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
---

<div class="mx-auto max-w-310 px-5 pt-6 pb-2 sm:px-8 lg:px-14 lg:pb-2">
	<SectionEyebrow>Account</SectionEyebrow>
	<h1 class="mb-4 max-w-170 font-display text-[34px] leading-[1.05] font-bold tracking-[-0.025em] text-ink sm:text-[42px] lg:text-[46px]">
		Delete your MarketDay account
	</h1>
	<p class="max-w-160 text-[15.5px] leading-[1.6] text-body sm:text-[16.5px]">
		This page lets you request deletion of your MarketDay account and the personal data linked to
		it — no app install required. You can also do this from within the app: <strong>Profile → Settings → Delete account</strong>.
	</p>
</div>
