---
import PortalForm from '../ui/PortalForm.astro';
import type { BillingOverview, VendorSubscription } from '../../lib/api/vendor-billing';
import { formatDate, formatMoney, pluralise } from '../../lib/vendor-portal';

/**
 * What the vendor pays, and a way to pay it. One slot per market the vendor trades at, and at
 * least one. **The vendor never chooses the count.** They choose markets on the Markets tab
 * (`VendorMarkets`), and the API moves the subscription to match (`MatchMarketSlots`, prorated onto the next
 * invoice).
 *
 * - **No live subscription:** a button to Stripe Checkout, which the API sizes from the
 *   markets.
 * - **A live one:** the price, and nothing to change here.
 */
interface Props {
	overview: BillingOverview;
	subscription: VendorSubscription;
}

const { overview, subscription } = Astro.props;
const { pricing } = overview;

/** The API's floor for carrying a trial into Checkout (`start-subscription-checkout.use-case.ts`). */
const MIN_CARRIED_TRIAL_MS = 48 * 60 * 60 * 1000;

const subscribed = overview.hasSubscription;
const markets = subscription.marketsUsed;

const first = formatMoney(pricing.firstMarketCents, pricing.currency);
const extra = formatMoney(pricing.additionalMarketCents, pricing.currency);
const price = formatMoney(overview.monthlyCostCents, pricing.currency);

const trialCarried =
	subscription.status === 'TRIAL' &&
	!!subscription.trialEndsAt &&
	new Date(subscription.trialEndsAt).getTime() - Date.now() >= MIN_CARRIED_TRIAL_MS;
---

<section id="plan" aria-labelledby="plan-title" class="mb-6 scroll-mt-6 rounded-[28px] bg-white p-6 shadow-card sm:p-9">
	<h2 id="plan-title" class="mb-4 font-mono text-xs font-semibold tracking-[0.14em] text-brand uppercase">
		{subscribed ? 'Your plan' : 'Subscribe'}
	</h2>
	<p class="mb-1 font-display text-[22px] leading-[1.2] font-bold text-ink">
		{first} a month for your first market, {extra} for each extra one
	</p>
	<p class="mb-6 max-w-160 text-[15px] leading-[1.6] text-body">
		No commission on your sales. Your plan follows the markets you trade at: when you add or leave one on the
		<a href="/vendor/markets" class="font-semibold text-brand underline">Markets tab</a>, the difference is prorated
		on your next invoice.
	</p>

	<div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
		<p class="text-[15px] text-body">
			<span class="font-display text-[26px] font-bold text-ink">{price}</span> / month
		</p>
		<p class="text-[14.5px] text-muted">
			{
				markets > 0
					? `You trade at ${pluralise(markets, 'market')}.`
					: "You're not at a market yet, so this covers your first one."
			}
		</p>
	</div>

	{
		!subscribed && (
			<PortalForm portalAction="vendorBilling.checkout" class="mt-6">
				<button
					type="submit"
					data-submit
					data-busy-label="Opening secure checkout…"
					class="flex h-13 w-full items-center justify-center rounded-full bg-brand px-7 text-base font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
				>
					<span data-submit-label>Continue to secure payment</span>
				</button>
				<p data-form-status role="status" aria-live="polite" class="mt-4 hidden rounded-xl px-4 py-3 text-[14.5px]"></p>
				<p class="mt-4 text-[13.5px] text-muted">
					{trialCarried && (
						<>
							You won't be charged until your free trial ends on {formatDate(subscription.trialEndsAt)}.{' '}
						</>
					)}
					You'll pay on Stripe's secure checkout page and come straight back here. Your card details never touch
					MarketDay.
				</p>
			</PortalForm>
		)
	}
</section>
