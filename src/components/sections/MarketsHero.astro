---
import SiteNav from './SiteNav.astro';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import IconSearch from '../icons/IconSearch.astro';
import IconPin from '../icons/IconPin.astro';
---

<div class="relative overflow-hidden bg-forest">
	<div
		class="absolute -top-45 -right-30 h-80 w-80 rounded-full bg-[radial-gradient(circle,rgba(76,166,126,0.5),rgba(76,166,126,0)_70%)] lg:h-130 lg:w-130"
	>
	</div>
	<div class="relative mx-auto max-w-310">
		<SiteNav />
		<div class="px-5 pt-8 pb-5 sm:px-8 lg:px-14 lg:pt-11 lg:pb-6">
			<SectionEyebrow class="text-brand-light">Find a market</SectionEyebrow>
			<h1 class="mb-4 max-w-155 font-display text-[36px] leading-none font-bold tracking-[-0.03em] text-white sm:text-[46px] lg:text-[54px]">
				Every stall near you, in one place
			</h1>
			<p class="mb-7.5 max-w-125 text-pretty text-[16px] leading-[1.55] text-white/82 sm:text-[17.5px]">
				Search by town, day or produce. See who's trading this week and start a pre-order straight from the
				stall page.
			</p>

			{/* Wired up by the finder script in MarketsDirectory. The form only exists so Enter
				doesn't reload the page and mobile keyboards show a search key. */}
			<form role="search" class="flex max-w-190 flex-wrap items-center gap-2.5" data-market-search-form>
				<label
					class="flex h-14.5 flex-[1_1_340px] items-center gap-2.75 rounded-[15px] bg-white px-4.5 has-focus-visible:ring-4 has-focus-visible:ring-brand-light/50"
				>
					<IconSearch class="h-4.5 w-4.5 shrink-0" />
					<span class="sr-only">Search markets</span>
					<input
						type="search"
						name="q"
						autocomplete="off"
						placeholder="Town, market name or produce"
						class="min-w-0 flex-1 bg-transparent font-sans text-base text-ink outline-none placeholder:text-muted"
						data-market-search
					/>
				</label>
				<button
					type="button"
					class="flex h-14.5 cursor-pointer items-center gap-2.25 rounded-[15px] bg-white/14 px-5.5 text-[15.5px] font-semibold text-white transition-colors hover:bg-white/22 focus-visible:ring-4 focus-visible:ring-brand-light/50 focus-visible:outline-none disabled:cursor-wait disabled:opacity-70"
					data-market-locate
				>
					<IconPin class="h-4.25 w-4.25" />
					<span data-market-locate-label>Use my location</span>
				</button>
			</form>
			<p class="mt-3 min-h-5 text-[14px] text-white/75" role="status" data-market-locate-status></p>
		</div>
	</div>
</div>
