---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { aboutStats } from '../../data/about';
---

<div class="bg-ink">
	<div class="mx-auto max-w-310 px-5 py-16 sm:px-8 lg:px-14 lg:py-22">
		<div class="mb-12 max-w-140">
			<SectionEyebrow class="text-amber">Impact so far</SectionEyebrow>
			<h2 class="font-display text-[32px] leading-[1.05] font-bold tracking-[-0.02em] text-white sm:text-[36px] lg:text-[40px]">
				Small orders, adding up to a lot less waste
			</h2>
		</div>
		<div class="grid grid-cols-2 gap-x-5 gap-y-8 divide-x divide-white/12 lg:grid-cols-4 lg:gap-y-0">
			{
				aboutStats.map((stat) => (
					<div class="pl-5 first:pl-0">
						<div class="mb-2 font-display text-[38px] font-bold tracking-[-0.02em] text-white sm:text-[46px]">
							{stat.value}
						</div>
						<div class="text-[15px] leading-[1.4] text-white/65">{stat.label}</div>
					</div>
				))
			}
		</div>
	</div>
</div>
