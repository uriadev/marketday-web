---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
---

<div class="mx-auto max-w-310 px-5 pt-6 pb-12 text-center sm:px-8 lg:px-14 lg:pb-16">
	<div class="flex justify-center">
		<SectionEyebrow>Vendor pricing</SectionEyebrow>
	</div>
	<h1 class="mx-auto mb-5 max-w-170 font-display text-[34px] leading-[1.05] font-bold tracking-[-0.025em] text-ink sm:text-[42px] lg:text-[50px]">
		Simple pricing, no surprises at payout
	</h1>
	<p class="mx-auto max-w-140 text-[16px] leading-[1.55] text-body sm:text-[18px]">
		MarketDay is free to join and free to use every market day. Upgrade to Pro only if you want extra
		tools across multiple stalls.
	</p>
</div>
