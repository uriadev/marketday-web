---
import IconCheck from '../icons/IconCheck.astro';
import {
	deleteAccountFormLimits,
	deleteAccountHoneypotField,
	deleteAccountSections,
	deleteAccountSupportEmail,
} from '../../data/delete-account';

const fieldClass =
	'h-11.5 w-full rounded-xl border border-[#E4E0D5] bg-cream px-3.5 text-[15px] text-ink placeholder:text-[#a9a598] focus:border-brand focus:outline-none aria-[invalid=true]:border-danger';
---

<div class="mx-auto flex max-w-310 flex-wrap items-start gap-10 px-5 pt-4 pb-16 sm:px-8 lg:gap-14 lg:px-14 lg:pb-24">
	<div class="flex min-w-0 flex-[1_1_480px] flex-col gap-9">
		{
			deleteAccountSections.map((section) => (
				<div>
					<h2 class="mb-3 font-display text-[20px] font-bold tracking-[-0.01em] text-ink sm:text-[22px]">{section.title}</h2>
					{section.blocks.map((block) => {
						if (block.kind === 'paragraph') {
							return <p class="mb-3 text-[15.5px] leading-[1.75] text-body last:mb-0">{block.text}</p>;
						}
						if (block.kind === 'paragraphWithLink') {
							return (
								<p class="mb-3 text-[15.5px] leading-[1.75] text-body last:mb-0">
									{block.before}
									<a href={block.linkHref}>{block.linkText}</a>
									{block.after}
								</p>
							);
						}
						const ListTag = block.ordered ? 'ol' : 'ul';
						return (
							<ListTag class="m-0 flex flex-col gap-1 pl-5.5 text-[15.5px] leading-[1.75] text-body">
								{block.items.map((item) => (
									<li>{item}</li>
								))}
							</ListTag>
						);
					})}
				</div>
			))
		}
	</div>

	<div class="w-full flex-[1_1_380px] sm:max-w-110">
		<div class="rounded-[22px] border border-[#ECE7DA] bg-white p-7 sm:p-8">
			<div data-sent-panel class="hidden">
				<div class="mb-4.5 flex h-12 w-12 items-center justify-center rounded-full bg-mint">
					<IconCheck class="h-5.5 w-5.5 text-forest" strokeWidth={2.4} />
				</div>
				<h3 class="mb-2.5 font-display text-[20px] font-bold text-ink">Request received</h3>
				<p class="text-[15px] leading-[1.65] text-body">
					Thanks — we've received your account deletion request. A member of the team will verify
					it's really you and follow up by email at the address you provided, usually within a few
					business days. Nothing is deleted until we've confirmed with you directly.
				</p>
			</div>

			<div data-form-panel>
				<h3 class="mb-1.5 font-display text-[20px] font-bold text-ink">Request account deletion</h3>
				<p class="mb-5.5 text-[14px] leading-[1.6] text-muted">
					We'll verify it's you and follow up by email before anything is deleted.
				</p>

				<form data-delete-account-form novalidate class="flex flex-col gap-4">
					<div>
						<label for="delete-account-email" class="mb-1.5 block text-[13.5px] font-semibold text-ink">
							Account email
						</label>
						<input
							id="delete-account-email"
							name="email"
							type="email"
							required
							autocomplete="email"
							maxlength={deleteAccountFormLimits.email.max}
							aria-describedby="delete-account-error"
							placeholder="you@example.com"
							class={fieldClass}
						/>
					</div>

					{/* Honeypot: off-screen, not display:none, so a capable bot that skips hidden
						fields still fills this one in — see contactHoneypotField for the same idea. */}
					<div class="absolute left-[-9999px] h-px w-px overflow-hidden" aria-hidden="true">
						<label for="delete-account-company">Company</label>
						<input
							id="delete-account-company"
							name={deleteAccountHoneypotField}
							type="text"
							tabindex="-1"
							autocomplete="off"
						/>
					</div>

					{/* Stamped by the script below, so a CDN-cached page never ships a fixed timestamp. */}
					<input type="hidden" name="renderedAt" value="" data-rendered-at />

					<label class="flex cursor-pointer items-start gap-2.5">
						<input
							type="checkbox"
							name="confirmed"
							required
							class="mt-0.75 h-4 w-4 accent-brand"
						/>
						<span class="text-[14px] leading-normal text-body">
							I want to delete my MarketDay account and associated personal data.
						</span>
					</label>

					<p id="delete-account-error" data-form-error class="hidden text-[13.5px] text-danger"></p>

					<button
						type="submit"
						data-submit
						class="mt-1 h-12 rounded-full bg-forest text-[15px] font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
					>
						<span data-submit-label>Send confirmation email</span>
					</button>
				</form>

				<p class="mt-4 text-[12.5px] leading-normal text-muted">
					A real person reviews every request — we'll never ask for your password by email.
				</p>

				<noscript>
					<p class="mt-4 rounded-xl bg-cream px-4 py-3 text-[14.5px] text-body">
						This form needs JavaScript. You can email us directly at{' '}
						<a href={`mailto:${deleteAccountSupportEmail}`}>{deleteAccountSupportEmail}</a>.
					</p>
				</noscript>
			</div>
		</div>

		<p class="mt-4 text-[13.5px] leading-[1.6] text-muted">
			Trouble with the form? Email{' '}
			<a href={`mailto:${deleteAccountSupportEmail}`}>{deleteAccountSupportEmail}</a> from your
			account address and we'll handle it manually.
		</p>
	</div>
</div>

<script>
	import { actions, isInputError } from 'astro:actions';

	const form = document.querySelector<HTMLFormElement>('[data-delete-account-form]');
	const formPanel = document.querySelector<HTMLElement>('[data-form-panel]');
	const sentPanel = document.querySelector<HTMLElement>('[data-sent-panel]');

	if (form) {
		const renderedAtInput = form.querySelector<HTMLInputElement>('[data-rendered-at]');
		const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
		const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
		const errorSlot = form.querySelector<HTMLElement>('[data-form-error]');

		// Records when the page actually reached a browser. The server treats an implausibly
		// fast submission as a bot; see MIN_FILL_MS in src/actions/index.ts.
		if (renderedAtInput) renderedAtInput.value = String(Date.now());

		const setError = (message: string | null) => {
			if (!errorSlot) return;
			errorSlot.textContent = message ?? '';
			errorSlot.classList.toggle('hidden', !message);
		};

		const setBusy = (busy: boolean) => {
			if (submitButton) submitButton.disabled = busy;
			if (submitLabel) submitLabel.textContent = busy ? 'Sending...' : 'Send confirmation email';
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (submitButton?.disabled) return;

			setError(null);
			if (!form.reportValidity()) return;

			setBusy(true);
			try {
				const { error } = await actions.deleteAccount.request(new FormData(form));

				if (isInputError(error)) {
					setError('Please enter your account email and check the confirmation box.');
					return;
				}
				if (error) {
					setError(error.message);
					return;
				}

				formPanel?.classList.add('hidden');
				sentPanel?.classList.remove('hidden');
			} catch {
				setError('We could not reach the server. Please check your connection and try again.');
			} finally {
				setBusy(false);
			}
		});
	}
</script>
