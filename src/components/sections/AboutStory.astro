---
import { Image } from 'astro:assets';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import storyImage from '../../assets/marketday/market-1.png';
---

<div class="mx-auto flex max-w-310 flex-wrap items-center gap-10 px-5 pb-16 sm:px-8 lg:gap-14 lg:px-14 lg:pb-24">
	<div class="relative min-h-95 flex-[1_1_420px] overflow-hidden rounded-[28px]">
		<Image
			src={storyImage}
			alt=""
			widths={[480, 768, 1024, 1376]}
			sizes="(min-width: 1024px) 46vw, 100vw"
			class="absolute inset-0 h-full w-full object-cover"
		/>
	</div>
	<div class="min-w-80 flex-[1_1_420px]">
		<SectionEyebrow>Our story</SectionEyebrow>
		<h2 class="mb-4.5 font-display text-[30px] leading-[1.08] font-bold tracking-[-0.02em] text-ink sm:text-[36px]">
			A better handshake between stall and shopper
		</h2>
		<p class="mb-4 text-[16px] leading-[1.65] text-body">
			MarketDay is starting in Cork with a simple idea: let people reserve what they want before they arrive.
			That means stallholders can pick to order instead of guessing what a Saturday crowd will want.
		</p>
		<p class="text-[16px] leading-[1.65] text-body">
			As we grow, we’ll bring that better handshake between stall and shopper to markets across Ireland — no
			middlemen, no marked-up prices, just a faster way to get good food into good hands.
		</p>
	</div>
</div>
