---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { termsMeta } from '../../data/terms';
---

<div class="mx-auto max-w-310 px-5 pt-6 pb-6 sm:px-8 lg:px-14 lg:pb-8">
	<SectionEyebrow>Legal</SectionEyebrow>
	<h1 class="mb-4 font-display text-[34px] leading-[1.03] font-bold tracking-[-0.025em] text-ink sm:text-[42px] lg:text-[50px]">
		Terms of Service
	</h1>
	<p class="text-[15.5px] text-muted">Last updated {termsMeta.lastUpdated}</p>
</div>
