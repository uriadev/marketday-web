---
import { Menu, X } from '@lucide/astro';
import { brand, primaryNavLinks } from '../../data/site';

interface Props {
	variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
const isLight = variant === 'light';
---

<div class="group relative flex items-center justify-between px-5 py-6.5 sm:px-8 lg:px-14">
	<a href="/" class="flex items-center gap-2.5">
		<div class="flex h-8.5 w-8.5 items-center justify-center overflow-hidden rounded-[10px] bg-white">
			<img src={brand.logo} alt={brand.name} class="h-6.5 w-6.5 object-contain" />
		</div>
		<span class:list={['font-display text-[21px] font-bold tracking-[-0.02em]', isLight ? 'text-ink' : 'text-white']}>
			{brand.name}
		</span>
	</a>
	<div class="flex items-center gap-4 md:gap-8.5">
		{
			primaryNavLinks.map((link) => (
				<a href={link.href} class:list={['hidden text-[15px] font-medium md:inline', isLight ? 'text-body' : 'text-white/80']}>
					{link.label}
				</a>
			))
		}
		<a
			href="/#download"
			class:list={[
				'flex h-11 items-center rounded-full px-5.5 text-[15px] font-semibold',
				isLight ? 'bg-forest text-white' : 'bg-white text-ink',
			]}
		>
			Get the app
		</a>
		<label
			class:list={[
				'flex h-11 w-11 cursor-pointer items-center justify-center rounded-full md:hidden',
				isLight ? 'text-ink has-focus-visible:ring-2 has-focus-visible:ring-ink/20' : 'text-white has-focus-visible:ring-2 has-focus-visible:ring-white/60',
			]}
		>
			<input type="checkbox" class="peer sr-only" aria-label="Toggle navigation menu" />
			<Menu class="h-6 w-6 peer-checked:hidden" />
			<X class="hidden h-6 w-6 peer-checked:block" />
		</label>
	</div>
	<nav
		aria-label="Mobile"
		class:list={[
			'absolute inset-x-0 top-full z-20 hidden flex-col border-t px-5 pt-2 pb-4 group-has-checked:flex md:hidden',
			isLight ? 'border-ink/10 bg-cream' : 'border-white/10 bg-forest',
		]}
	>
		{
			primaryNavLinks.map((link) => (
				<a href={link.href} class:list={['py-3 text-[17px] font-medium', isLight ? 'text-body' : 'text-white/85']}>
					{link.label}
				</a>
			))
		}
	</nav>
</div>
