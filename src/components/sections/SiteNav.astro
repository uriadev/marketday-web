---
import { Menu, X } from '@lucide/astro';
import { brand, primaryNavLinks } from '../../data/site';
---

<div class="group relative flex items-center justify-between px-5 py-6.5 sm:px-8 lg:px-14">
	<a href="#" class="flex items-center gap-2.5">
		<div class="flex h-8.5 w-8.5 items-center justify-center overflow-hidden rounded-[10px] bg-white">
			<img src={brand.logo} alt={brand.name} class="h-6.5 w-6.5 object-contain" />
		</div>
		<span class="font-display text-[21px] font-bold tracking-[-0.02em] text-white">{brand.name}</span>
	</a>
	<div class="flex items-center gap-4 md:gap-8.5">
		{primaryNavLinks.map((link) => <a href={link.href} class="hidden text-[15px] font-medium text-white/80 md:inline">{link.label}</a>)}
		<a href="#download" class="flex h-11 items-center rounded-full bg-white px-5.5 text-[15px] font-semibold text-ink">
			Get the app
		</a>
		<label
			class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-white has-focus-visible:ring-2 has-focus-visible:ring-white/60 md:hidden"
		>
			<input type="checkbox" class="peer sr-only" aria-label="Toggle navigation menu" />
			<Menu class="h-6 w-6 peer-checked:hidden" />
			<X class="hidden h-6 w-6 peer-checked:block" />
		</label>
	</div>
	<nav
		aria-label="Mobile"
		class="absolute inset-x-0 top-full z-20 hidden flex-col border-t border-white/10 bg-forest px-5 pt-2 pb-4 group-has-checked:flex md:hidden"
	>
		{primaryNavLinks.map((link) => <a href={link.href} class="py-3 text-[17px] font-medium text-white/85">{link.label}</a>)}
	</nav>
</div>
