---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
---

<div class="mx-auto max-w-310 px-5 pt-6 pb-10 sm:px-8 lg:px-14 lg:pb-14">
	<SectionEyebrow>Contact</SectionEyebrow>
	<h1 class="mb-5 max-w-170 font-display text-[34px] leading-[1.05] font-bold tracking-[-0.025em] text-ink sm:text-[42px] lg:text-[50px]">
		Question, idea, or a stall to add?
	</h1>
	<p class="max-w-150 text-[16px] leading-[1.55] text-body sm:text-[18px]">
		We usually reply within a few hours on market days. For order help, the fastest route is Help &
		support inside the app.
	</p>
</div>
