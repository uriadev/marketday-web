---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import { brand } from '../../data/site';
import { vendorPortalFormLimits } from '../../data/vendor-portal';

/**
 * Two steps on one page: ask for the emailed 6-digit code, then set a new password with it.
 * The same flow sets a first password for an owner an admin created, who has none yet.
 * The second step signs the owner in (`actions.vendor.resetPassword`), so it ends in the
 * portal, not back at the sign-in form.
 */
interface Props {
	/** Already passed through `safeNextPath`. */
	next: string;
}

const { next } = Astro.props;
const { email, newPassword, resetCode } = vendorPortalFormLimits;

const fieldClass =
	'h-12 w-full rounded-xl border border-[#E4E0D5] bg-cream px-4 text-[15px] text-ink placeholder:text-[#a9a598] focus:border-brand focus:outline-none aria-[invalid=true]:border-danger';
const errorClass = 'mt-1.5 hidden text-[13px] text-danger';
const submitClass =
	'flex h-13 w-full items-center justify-center rounded-full bg-brand text-base font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60';
const statusClass = 'mt-4 hidden rounded-xl px-4 py-3 text-[14.5px]';
---

<div class="mx-auto max-w-130 pt-6 sm:pt-10" data-password-reset>
	<SectionEyebrow>Vendor portal</SectionEyebrow>
	<h1
		class="mb-3 font-display text-[32px] leading-[1.05] font-bold tracking-[-0.025em] text-ink sm:text-[40px]"
	>
		Set a new password
	</h1>
	<p class="mb-7 text-[15.5px] leading-[1.6] text-body">
		We'll email you a 6-digit code. It also works if your account was set up for you and you've never had a
		password.
	</p>

	<div class="rounded-[28px] bg-white p-6 shadow-card sm:p-9">
		<form data-reset-request novalidate>
			<div class="mb-6">
				<label for="reset-email" class="mb-2 block text-[13px] font-semibold text-ink">Email</label>
				<input
					id="reset-email"
					name="email"
					type="email"
					required
					autocomplete="username"
					maxlength={email.max}
					aria-describedby="reset-email-error"
					placeholder="you@example.com"
					class={fieldClass}
				/>
				<p id="reset-email-error" data-error-for="email" class={errorClass}></p>
			</div>
			<button type="submit" data-submit class={submitClass}>
				<span data-submit-label>Email me a code</span>
			</button>
			<p data-form-status role="status" aria-live="polite" class={statusClass}></p>
		</form>

		<form data-reset-confirm novalidate class="hidden">
			<p class="mb-5 rounded-xl bg-mint px-4 py-3 text-[14.5px] text-forest" role="status">
				If <strong data-reset-email-label></strong> has an account, a code is on its way. It works for 15
				minutes. If you only sign in with Google, the email says so instead.
			</p>
			<input type="hidden" name="email" data-reset-email />
			<input type="hidden" name="next" value={next} />

			<div class="mb-4">
				<label for="reset-code" class="mb-2 block text-[13px] font-semibold text-ink">6-digit code</label>
				<input
					id="reset-code"
					name="code"
					type="text"
					required
					inputmode="numeric"
					autocomplete="one-time-code"
					pattern={`\\d{${resetCode.length}}`}
					minlength={resetCode.length}
					maxlength={resetCode.length}
					aria-describedby="reset-code-error"
					class:list={[fieldClass, 'font-mono tracking-[0.3em]']}
				/>
				<p id="reset-code-error" data-error-for="code" class={errorClass}></p>
			</div>

			<div class="mb-4">
				<label for="reset-password" class="mb-2 block text-[13px] font-semibold text-ink">New password</label>
				<input
					id="reset-password"
					name="password"
					type="password"
					required
					autocomplete="new-password"
					minlength={newPassword.min}
					maxlength={newPassword.max}
					aria-describedby="reset-password-hint reset-password-error"
					class={fieldClass}
				/>
				<p id="reset-password-hint" class="mt-1.5 text-[13px] text-muted">At least {newPassword.min} characters.</p>
				<p id="reset-password-error" data-error-for="password" class={errorClass}></p>
			</div>

			<div class="mb-6">
				<label for="reset-password-confirm" class="mb-2 block text-[13px] font-semibold text-ink"
					>Confirm new password</label
				>
				<input
					id="reset-password-confirm"
					name="confirmPassword"
					type="password"
					required
					autocomplete="new-password"
					maxlength={newPassword.max}
					aria-describedby="reset-password-confirm-error"
					class={fieldClass}
				/>
				<p id="reset-password-confirm-error" data-error-for="confirmPassword" class={errorClass}></p>
			</div>

			<button type="submit" data-submit class={submitClass}>
				<span data-submit-label>Save password and sign in</span>
			</button>
			<p data-form-status role="status" aria-live="polite" class={statusClass}></p>

			<button type="button" data-reset-restart class="mt-4 w-full text-center text-[14px] font-semibold text-[#2f6a4d]">
				Use a different email or send a new code
			</button>
		</form>

		<noscript>
			<p class="mt-4 rounded-xl bg-cream px-4 py-3 text-[14.5px] text-body">
				This form needs JavaScript. If you can't turn it on, email us at{' '}
				<a href={`mailto:${brand.email}`}>{brand.email}</a>.
			</p>
		</noscript>
	</div>

	<p class="mt-6 text-center text-[14.5px] text-body">
		Remembered it? <a href={`/vendor/login?next=${encodeURIComponent(next)}`} class="font-semibold">Sign in</a>
	</p>
</div>

<script>
	import { actions, isInputError } from 'astro:actions';

	const UNREACHABLE = 'We could not reach the server. Please check your connection and try again.';

	const root = document.querySelector<HTMLElement>('[data-password-reset]');
	const requestForm = root?.querySelector<HTMLFormElement>('[data-reset-request]');
	const confirmForm = root?.querySelector<HTMLFormElement>('[data-reset-confirm]');

	if (root && requestForm && confirmForm) {
		const emailInput = requestForm.querySelector<HTMLInputElement>('[name="email"]');
		const carriedEmail = confirmForm.querySelector<HTMLInputElement>('[data-reset-email]');
		const emailLabel = confirmForm.querySelector<HTMLElement>('[data-reset-email-label]');

		const setStatus = (form: HTMLFormElement, message: string) => {
			const status = form.querySelector<HTMLElement>('[data-form-status]');
			if (!status) return;
			// textContent only: the message is ours or the API's deliberately authored refusal.
			status.textContent = message;
			status.classList.remove('hidden');
			status.classList.add('bg-danger/10', 'text-danger');
		};

		const clearErrors = (form: HTMLFormElement) => {
			form.querySelector<HTMLElement>('[data-form-status]')?.classList.add('hidden');
			form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
				el.textContent = '';
				el.classList.add('hidden');
			});
			form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
		};

		const showFieldErrors = (form: HTMLFormElement, fields: Record<string, string[] | undefined>) => {
			let first: HTMLElement | null = null;
			for (const [field, messages] of Object.entries(fields)) {
				if (!messages?.length) continue;
				const slot = form.querySelector<HTMLElement>(`[data-error-for="${CSS.escape(field)}"]`);
				const input = form.querySelector<HTMLElement>(`[name="${CSS.escape(field)}"]`);
				if (slot) {
					slot.textContent = messages.join(' ');
					slot.classList.remove('hidden');
				}
				if (input && input.getAttribute('type') !== 'hidden') {
					input.setAttribute('aria-invalid', 'true');
					first ??= input;
				}
			}
			first?.focus();
		};

		const setBusy = (form: HTMLFormElement, busy: boolean, busyLabel: string, idleLabel: string) => {
			const button = form.querySelector<HTMLButtonElement>('[data-submit]');
			const label = form.querySelector<HTMLElement>('[data-submit-label]');
			if (button) button.disabled = busy;
			if (label) label.textContent = busy ? busyLabel : idleLabel;
		};

		const showStep = (step: 'request' | 'confirm') => {
			requestForm.classList.toggle('hidden', step !== 'request');
			confirmForm.classList.toggle('hidden', step !== 'confirm');
			const focusTarget =
				step === 'request' ? emailInput : confirmForm.querySelector<HTMLInputElement>('[name="code"]');
			focusTarget?.focus();
		};

		requestForm.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors(requestForm);
			if (!requestForm.reportValidity()) return;

			setBusy(requestForm, true, 'Sending…', 'Email me a code');
			try {
				const { error } = await actions.vendor.requestPasswordReset(new FormData(requestForm));
				if (isInputError(error)) {
					showFieldErrors(requestForm, error.fields);
					return;
				}
				if (error) {
					setStatus(requestForm, error.message);
					return;
				}
				const email = emailInput?.value.trim() ?? '';
				if (carriedEmail) carriedEmail.value = email;
				if (emailLabel) emailLabel.textContent = email;
				confirmForm.reset();
				if (carriedEmail) carriedEmail.value = email;
				showStep('confirm');
			} catch {
				setStatus(requestForm, UNREACHABLE);
			} finally {
				setBusy(requestForm, false, 'Sending…', 'Email me a code');
			}
		});

		confirmForm.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors(confirmForm);
			if (!confirmForm.reportValidity()) return;

			let leaving = false;
			setBusy(confirmForm, true, 'Saving…', 'Save password and sign in');
			try {
				const { data, error } = await actions.vendor.resetPassword(new FormData(confirmForm));
				if (isInputError(error)) {
					showFieldErrors(confirmForm, error.fields);
					return;
				}
				if (error) {
					setStatus(confirmForm, error.message);
					return;
				}
				if (data.redirect.startsWith('/') && !data.redirect.startsWith('//')) {
					leaving = true;
					window.location.assign(data.redirect);
				}
			} catch {
				setStatus(confirmForm, UNREACHABLE);
			} finally {
				if (!leaving) setBusy(confirmForm, false, 'Saving…', 'Save password and sign in');
			}
		});

		root.querySelector('[data-reset-restart]')?.addEventListener('click', () => {
			clearErrors(requestForm);
			showStep('request');
		});
	}
</script>
