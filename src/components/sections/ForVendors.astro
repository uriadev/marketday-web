---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import CheckListItem from '../ui/CheckListItem.astro';
import IconBox from '../icons/IconBox.astro';
import { vendorBenefits } from '../../data/home';
---

<div id="for-vendors" class="mx-auto max-w-310 px-14 pt-0 pb-24">
	<div class="flex flex-wrap overflow-hidden rounded-[28px] bg-ink">
		<div class="flex-[1_1_460px] p-14">
			<SectionEyebrow class="text-amber">For vendors</SectionEyebrow>
			<h2 class="mb-4.5 font-display text-[40px] leading-[1.05] font-bold tracking-[-0.02em] text-white">
				Sell more, waste less, know your day before it starts
			</h2>
			<p class="mb-7 max-w-110 text-[16.5px] leading-[1.6] text-white/78">
				Take pre-orders across every market you trade at, manage stock per stall, and get paid straight
				to your account.
			</p>
			<div class="mb-8.5 flex flex-col gap-3.5">
				{vendorBenefits.map((benefit) => <CheckListItem label={benefit.label} />)}
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<a href="#" class="flex h-13 items-center rounded-full bg-brand px-6.5 text-base font-semibold text-white">
					Start selling
				</a>
				<span class="text-[14.5px] text-white/60">Free to join · live in a day</span>
			</div>
		</div>
		<div class="relative min-h-95 flex-[1_1_360px] bg-ink-soft">
			<div
				class="absolute -top-15 -left-10 h-75 w-75 rounded-full bg-[radial-gradient(circle,rgba(76,166,126,0.5),rgba(76,166,126,0)_70%)]"
			>
			</div>
			<div
				class="absolute -right-15 -bottom-20 h-65 w-65 rounded-full bg-[radial-gradient(circle,rgba(215,122,69,0.35),rgba(215,122,69,0)_70%)]"
			>
			</div>
			<div class="absolute inset-0 flex items-center justify-center">
				<IconBox class="h-30 w-30 text-brand opacity-90" strokeWidth={1.4} />
			</div>
		</div>
	</div>
</div>
