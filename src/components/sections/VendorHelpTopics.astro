---
import TopicCard from '../ui/TopicCard.astro';
import { vendorHelpTopics } from '../../data/vendor-help';
---

<div class="mx-auto max-w-310 px-5 pb-16 sm:px-8 lg:px-14 lg:pb-24">
	<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
		{vendorHelpTopics.map((topic) => <TopicCard {...topic} />)}
	</div>
</div>
