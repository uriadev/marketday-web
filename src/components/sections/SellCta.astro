---
import { launchOffer, pilot } from '../../data/pricing';
---

<div class="mx-auto max-w-310 px-5 pb-16 text-center sm:px-8 lg:px-14 lg:pb-24">
	<h2 class="mb-4 font-display text-[32px] leading-[1.05] font-bold tracking-[-0.02em] text-ink sm:text-[36px] lg:text-[40px]">
		Ready to trade smarter this weekend?
	</h2>
	<p class="mb-7 text-[16.5px] text-body">
		{pilot.active ? 'MarketDay is free for vendors during our pilot, with no card and no commission' : `Your first 30 days are on us${launchOffer.active ? ', and launch vendors pay half price for six months after that' : ''}`}. See the details on our <a href="/pricing">Pricing page</a>, or jump straight in.
	</p>
	<a href="/sell-with-us/apply" class="inline-flex h-13.5 items-center rounded-full bg-brand px-7.5 text-base font-semibold text-white">
		Start selling
	</a>
</div>
