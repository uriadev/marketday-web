---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import FaqItem from '../ui/FaqItem.astro';
import { faqs } from '../../data/home';
---

<div class="bg-sand">
	<div class="mx-auto flex max-w-310 flex-wrap items-start gap-10 px-5 py-16 sm:px-8 lg:gap-14 lg:px-14 lg:py-24">
		<div class="flex-[1_1_320px] lg:flex-[0_0_320px]">
			<SectionEyebrow>FAQ</SectionEyebrow>
			<h2 class="mb-4 font-display text-[30px] leading-[1.05] font-bold tracking-[-0.02em] text-ink sm:text-[36px] lg:text-[40px]">
				Good questions, quick answers
			</h2>
			<p class="text-[15.5px] leading-[1.6] text-body">
				Still stuck? Reach us in the app under Help &amp; support — we usually reply within a few hours
				on market days.
			</p>
		</div>
		<div class="flex flex-[1_1_480px] flex-col gap-3">
			{faqs.map((faq) => <FaqItem {...faq} />)}
		</div>
	</div>
</div>
