---
import StoreBadge from '../ui/StoreBadge.astro';
---

<div id="download" class="relative overflow-hidden bg-brand text-center">
	<div class="mx-auto max-w-310 px-5 py-16 sm:px-8 lg:px-14 lg:py-24">
		<h2 class="mb-4 font-display text-[34px] leading-none font-bold tracking-tight text-white sm:text-[44px] lg:text-[52px]">
			Your next market run<br class="hidden sm:inline" />{' '}starts in the app
		</h2>
		<p class="mx-auto mb-8 max-w-115 text-lg leading-normal text-white/90">
			Free to download. No booking fees, ever. Just fresher food and shorter queues.
		</p>
		<div class="flex flex-wrap items-center justify-center gap-3">
			<StoreBadge store="apple" theme="dark" href="#" />
			<StoreBadge store="google" theme="dark" href="#" />
		</div>
	</div>
</div>
