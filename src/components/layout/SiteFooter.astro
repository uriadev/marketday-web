---
import { brand, footerColumns, legalLinks } from '../../data/site';
---

<div class="bg-ink">
	<div class="mx-auto max-w-310 px-14 pt-16 pb-12">
		<div class="mb-12 flex flex-wrap justify-between gap-12">
			<div class="max-w-85 flex-[1_1_280px]">
				<div class="mb-4 flex items-center gap-2.5">
					<div class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-[10px] bg-white">
						<img src={brand.logo} alt={brand.name} class="h-6 w-6 object-contain" />
					</div>
					<span class="font-display text-xl font-bold text-white">{brand.name}</span>
				</div>
				<p class="text-[14.5px] leading-[1.6] text-white/60">
					Pre-order the freshest produce from your local market. Made in Dublin, for market days everywhere.
				</p>
			</div>
			<div class="flex flex-wrap gap-16">
				{
					footerColumns.map((column) => (
						<div class="flex flex-col gap-3">
							<span class="text-xs font-bold tracking-widest text-white/40 uppercase">{column.title}</span>
							{column.links.map((link) => (
								<a href={link.href} class="text-[14.5px] text-white/75">
									{link.label}
								</a>
							))}
						</div>
					))
				}
			</div>
		</div>
		<div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/12 pt-6">
			<span class="text-[13.5px] text-white/45">© 2026 MarketDay. All rights reserved.</span>
			<div class="flex items-center gap-4.5">
				{legalLinks.map((link) => <a href={link.href} class="text-[13.5px] text-white/45">{link.label}</a>)}
			</div>
		</div>
	</div>
</div>
