---
interface Props {
	class?: string;
	strokeWidth?: number;
}

const { class: className, strokeWidth = 2 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
	<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width={strokeWidth}></circle>
	<path
		d="M12 7.5V12l3 2"
		stroke="currentColor"
		stroke-width={strokeWidth}
		stroke-linecap="round"
		stroke-linejoin="round"></path>
</svg>
