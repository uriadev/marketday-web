---
interface Props {
	class?: string;
	strokeWidth?: number;
}

const { class: className, strokeWidth = 1.9 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
	<path
		d="M12 3l2.4 5 5.6.7-4 3.9 1 5.4L12 15.4 7 18l1-5.4-4-3.9 5.6-.7L12 3z"
		stroke="currentColor"
		stroke-width={strokeWidth}
		stroke-linejoin="round"></path>
</svg>
