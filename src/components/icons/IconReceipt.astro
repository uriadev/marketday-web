---
interface Props {
	class?: string;
	strokeWidth?: number;
}

const { class: className, strokeWidth = 1.9 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
	<rect x="3" y="6" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width={strokeWidth}></rect>
	<path d="M3 10h18" stroke="currentColor" stroke-width={strokeWidth}></path>
</svg>
