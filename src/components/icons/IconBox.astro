	<path d="M4 9h16v9a2 2 0 01-2 2H6a2 2 0 01-2-2V9z" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round"
	></path>
	<path
		d="M4 9l2.5-4.2A2 2 0 018.2 4h7.6a2 2 0 011.7.8L20 9"
		stroke="currentColor"
		stroke-width={strokeWidth}
		stroke-linejoin="round"></path>
