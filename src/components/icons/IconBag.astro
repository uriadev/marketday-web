---
interface Props {
	class?: string;
	strokeWidth?: number;
}

const { class: className, strokeWidth = 1.9 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
	<path
		d="M5 8h14l-1.4 10.2a2 2 0 01-2 1.8H8.4a2 2 0 01-2-1.8L5 8z"
		stroke="currentColor"
		stroke-width={strokeWidth}
		stroke-linejoin="round"></path>
	<path d="M9 8a3 3 0 016 0" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round"></path>
</svg>
