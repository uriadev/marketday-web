---
interface Props {
	class?: string;
	strokeWidth?: number;
}

const { class: className, strokeWidth = 3 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
	<path
		d="M5 13l4 4 10-10"
		stroke="currentColor"
		stroke-width={strokeWidth}
		stroke-linecap="round"
		stroke-linejoin="round"></path>
</svg>
