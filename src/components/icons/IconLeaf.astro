---
interface Props {
	class?: string;
	strokeWidth?: number;
}

const { class: className, strokeWidth = 1.9 } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
	<path
		d="M12 21c5-2.5 8-6.5 8-11a8 8 0 00-8-3 8 8 0 00-8 3c0 4.5 3 8.5 8 11z"
		stroke="currentColor"
		stroke-width={strokeWidth}
		stroke-linejoin="round"></path>
	<path d="M12 8v13" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round"></path>
</svg>
