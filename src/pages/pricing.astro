---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/sections/SiteNav.astro';
import PricingHero from '../components/sections/PricingHero.astro';
import PricingPlans from '../components/sections/PricingPlans.astro';
import PricingFeeNote from '../components/sections/PricingFeeNote.astro';
import PricingCta from '../components/sections/PricingCta.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
---

<Layout
	title="Pricing — MarketDay"
	description="Try MarketDay free for 30 days, then pay €10 a month for your first market and €5 for each extra one. No commission on your sales, ever."
>
	<div class="w-full overflow-hidden">
		<div class="mx-auto max-w-310">
			<SiteNav variant="light" />
		</div>
		<PricingHero />
		<PricingPlans />
		<PricingFeeNote />
		<PricingCta />
		<SiteFooter />
	</div>
</Layout>
