---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import WhyMarketDay from '../components/sections/WhyMarketDay.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import ForVendors from '../components/sections/ForVendors.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import AppInviteModal from '../components/ui/AppInviteModal.astro';
---

<Layout>
	<div class="w-full overflow-hidden">
		<Hero />
		<HowItWorks />
		<WhyMarketDay />
		<Testimonials />
		<ForVendors />
		<Faq />
		<FinalCta />
		<SiteFooter />
	</div>
	{/* Shared by the store badges in Hero and FinalCta, so it belongs to the page rather than
		to either section. Outside the wrapper above: nothing should clip a modal. */}
	<AppInviteModal />
</Layout>
