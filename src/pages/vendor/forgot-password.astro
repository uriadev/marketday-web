---
// On-demand, like every /vendor/* page — see src/middleware.ts.
export const prerender = false;

import VendorPortalLayout from '../../layouts/VendorPortalLayout.astro';
import VendorPasswordReset from '../../components/sections/VendorPasswordReset.astro';
import { safeNextPath } from '../../lib/security/redirects';

const next = safeNextPath(Astro.url.searchParams.get('next'));
---

<VendorPortalLayout title="Set a new password" description="Reset or set the password for your MarketDay vendor account.">
	<VendorPasswordReset next={next} />
</VendorPortalLayout>
