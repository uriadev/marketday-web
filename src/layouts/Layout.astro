---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'MarketDay — Your market, pre-ordered.',
	description = 'Reserve produce from local stalls in two minutes, pick a collection time, and pay when you arrive. No queues, no booking fees.',
} = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/png" href="/assets/marketday/logo.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="m-0 w-full">
		<slot />
	</body>
</html>
